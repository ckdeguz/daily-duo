rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users: PUBLIC profiles (name/avatar/username are shown to friends) ───
    //
    // ⚠️  This doc is world-readable and the `usernames` index below is
    // enumerable, so anything stored here is effectively published. Store
    // PUBLIC profile fields ONLY — never email, phone, or other PII.
    // (An `email` field lived here previously; auth.js now strips it.)
    match /users/{uid} {
      allow read: if true;
      // A user may create/update only their own doc. Username fields are set
      // via the usernames transaction below; entitlements must not be self-granted.
      allow create: if request.auth != null && request.auth.uid == uid
                    && !( 'extraQuestions' in request.resource.data.get('entitlements', {})
                          && request.resource.data.entitlements.extraQuestions == true );
      allow update: if request.auth != null && request.auth.uid == uid
                    && entitlementsUnchangedOrServerOnly();
    }

    // Entitlements can only be granted server-side (Cloud Function w/ admin SDK,
    // which bypasses rules). Client updates must leave them as-is.
    function entitlementsUnchangedOrServerOnly() {
      let before = resource.data.get('entitlements', {});
      let after = request.resource.data.get('entitlements', {});
      return after == before
             || !( ('extraQuestions' in after && after.extraQuestions == true
                    && (!('extraQuestions' in before) || before.extraQuestions != true))
                   || ('removeAds' in after && after.removeAds == true
                       && (!('removeAds' in before) || before.removeAds != true)) );
    }

    // ─── Usernames: uniqueness index. Doc id == lowercase username. ───
    match /usernames/{name} {
      allow read: if true; // lookup + availability checks
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      // Don't allow stealing/freeing a username casually.
      allow update, delete: if false;
    }

    // ─── Games: share-by-link model. Anyone with the id can read (like today). ───
    match /games/{gameId} {
      allow read: if true;

      // Create: must start as awaiting_p2 with no p2 yet.
      allow create: if validGameCreate(gameId);

      // Update: completing P2, or a signed-in user claiming a guest side.
      allow update: if completingP2() || claimingSide();
    }

    // Create: must start as awaiting_p2 with no p2 yet, and the creator may not
    // forge the game onto someone else's account — p1.uid must be either null
    // (guest play) or the caller's own uid. Scores stay null until completion.
    function validGameCreate(gameId) {
      let d = request.resource.data;
      return d.status == 'awaiting_p2'
             && d.p2 == null
             && d.gameId == gameId
             && (d.p1.uid == null
                 || (request.auth != null && d.p1.uid == request.auth.uid))
             && d.p1Score == null
             && d.p2Score == null
             && d.totalScore == null
             && d.pairId == null
             && d.participantUids == (d.p1.uid == null ? [] : [d.p1.uid]);
    }

    // P2 fills the currently-empty p2 side and marks the game complete.
    //
    // Scores are computed client-side (computeScores in db.js) and rules can't
    // recompute them — CEL has no loop over the answers array. What rules CAN
    // do is stop a completion from being forged onto another account, which is
    // what leaderboard integrity actually rests on: p2.uid must be null (guest)
    // or the caller's own, and participantUids/pairId must follow from the two
    // sides rather than being attacker-supplied.
    function completingP2() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'awaiting_p2'
             && before.p2 == null
             && after.status == 'complete'
             && after.p2 != null
             // p1 side is immutable during completion
             && after.p1 == before.p1
             && after.questions == before.questions
             // The completer may only claim themselves (or stay a guest).
             && (after.p2.uid == null
                 || (request.auth != null && after.p2.uid == request.auth.uid))
             // participantUids may only contain the two sides' real uids.
             && after.participantUids.hasOnly(realUids(after.p1.uid, after.p2.uid))
             // A pair requires two DIFFERENT signed-in players.
             && (after.pairId == null
                 || (after.p1.uid != null && after.p2.uid != null
                     && after.p1.uid != after.p2.uid));
    }

    // The non-null uids among the two sides, as a list.
    function realUids(a, b) {
      return (a == null ? [] : [a]).concat(b == null ? [] : [b]);
    }

    // A signed-in user backfills their uid onto a side they played as guest.
    //
    // Rules cannot verify the guestId match (the claimer proves possession of
    // the guest id via the client transaction in db.js `claimSide`), but they
    // MUST prevent a claim from being used as a general-purpose write. So:
    // exactly one side's previously-null uid may be set to the caller's own
    // uid, and every other meaningful field is pinned to its current value.
    function claimingSide() {
      let before = resource.data;
      let after = request.resource.data;
      return request.auth != null
             && after.questions == before.questions
             && after.status == before.status
             && after.p1Score == before.p1Score
             && after.p2Score == before.p2Score
             && after.totalScore == before.totalScore
             && after.participantUids.hasOnly(before.participantUids.concat([request.auth.uid]))
             // Exactly one side is claimed; the other is untouched.
             && ( (claimedSide(before.p1, after.p1) && after.p2 == before.p2)
                  || (claimedSide(before.p2, after.p2) && after.p1 == before.p1) );
    }

    // The claimed side: uid goes null -> caller's uid, nothing else changes.
    function claimedSide(before, after) {
      return before != null
             && after != null
             && before.uid == null
             && after.uid == request.auth.uid
             && after.guestId == before.guestId
             && after.name == before.name
             && after.answers == before.answers
             && after.guesses == before.guesses;
    }

    // ─── Leaderboard: per-pair best scores. Members only. ───
    match /leaderboard/{pairId} {
      // Authed users may read; if the doc exists they must be a member.
      // (A transaction reads the not-yet-existing doc before creating it,
      // so a missing doc must not be denied.)
      allow read: if request.auth != null
                  && (resource == null
                      || request.auth.uid in resource.data.members);
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.members;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members;
    }

    // ─── Friends (Phase 2 — declared now so writes don't fail closed) ───
    match /friendRequests/{id} {
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid;
      // Read split into two single-field conditions so QUERIES are provable:
      // a `where("toUid","==",me)` query satisfies the recipient clause, and a
      // `where("fromUid","==",me)` query satisfies the sender clause. (A combined
      // `uid in [fromUid,toUid]` form isn't provable from a single-field query
      // and Firestore rejects the whole query.)
      allow read: if request.auth != null
                  && (resource.data.toUid == request.auth.uid
                      || resource.data.fromUid == request.auth.uid);
      allow update: if request.auth != null
                    && (resource.data.toUid == request.auth.uid
                        || resource.data.fromUid == request.auth.uid);
      // Either party may delete: recipient deletes on accept; sender deletes a
      // now-moot pending request they sent (reverse-cleanup).
      allow delete: if request.auth != null
                    && (resource.data.toUid == request.auth.uid
                        || resource.data.fromUid == request.auth.uid);
    }
    match /friendships/{pairId} {
      // Authed users may probe a (possibly nonexistent) friendship doc; if it
      // exists they must be a member. A missing doc must not be denied so
      // existence checks / transaction reads work.
      allow read: if request.auth != null
                  && (resource == null
                      || request.auth.uid in resource.data.members);
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.members;
      // Either member may remove the friendship (deletes for both).
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.members;
    }
    match /inviteCodes/{code} {
      allow read: if true; // anyone opening an invite link can resolve it
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
    }
  }
}
